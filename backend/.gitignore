# ==============================================================================
# Dependency Directories (Never commit third-party packages)
# ==============================================================================
node_modules/
jspm_packages/
web_modules/
.pnp/
.pnp.js

# Python dependencies
venv/
.venv/
env/
.env/
ENV/
build/
dist/
*.egg-info/

# ==============================================================================
# Environment Variables & Secrets (CRITICAL: Protect credentials and API keys)
# ==============================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key
secrets.json

# ==============================================================================
# Operating System Files (Avoid polluting across different platforms)
# ==============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.lnk

# ==============================================================================
# IDEs and Text Editors
# ==============================================================================
# Visual Studio Code
.vscode/*
!.vscode/extensions.json
.history/

# IntelliJ / WebStorm / PyCharm
.idea/
*.iws

# Logs and databases
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
sqlite.db
